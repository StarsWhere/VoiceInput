<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>VoiceInput</AssemblyName>
    <RootNamespace>VoiceInput</RootNamespace>
    <Version>0.1.1</Version>
    <InformationalVersion>0.1.1+bs1.45.2</InformationalVersion>
    <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
    <FrameworkPathOverride>$(GameRoot)/Beat Saber_Data/Managed</FrameworkPathOverride>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;**/obj/**;**/bin/**</DefaultItemExcludes>
    <LocalModUIPath Condition="'$(LocalModUIPath)' == ''">$(SharedRoot)/.tmp/local-mod-ui/build/LocalModUI.dll</LocalModUIPath>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0618;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/Main.dll;$(GameRoot)/Beat Saber_Data/Managed/HMUI.dll"><Private>false</Private><Publicize>true</Publicize></Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/BeatSaber.ViewSystem.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/Zenject.dll"><Private>false</Private><Publicize>true</Publicize></Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/Zenject-usage.dll"><Private>false</Private></Reference>
    <Reference Include="LocalModUI"><HintPath>$(LocalModUIPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/Plugins/SiraUtil.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/IPA.Loader.dll;$(GameRoot)/Beat Saber_Data/Managed/HMLib.dll;$(GameRoot)/Beat Saber_Data/Managed/VRUI.dll;$(GameRoot)/Beat Saber_Data/Managed/VRUI.Interfaces.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.CoreModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.AudioModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UI.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UIModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.TextRenderingModule.dll;$(GameRoot)/Beat Saber_Data/Managed/Unity.TextMeshPro.dll;$(GameRoot)/Beat Saber_Data/Managed/netstandard.dll;$(GameRoot)/Beat Saber_Data/Managed/System.Net.Http.dll;$(GameRoot)/Libs/0Harmony.dll;$(GameRoot)/Libs/Newtonsoft.Json.dll;$(GameRoot)/Plugins/BSML.dll"><Private>false</Private></Reference>
    <Compile Include="$(SharedRoot)/scripts/shared_http_contracts/JsonContractRegistry.cs" Link="Shared/JsonContractRegistry.cs" />
    <Compile Include="$(ContractGeneratedDirectory)/**/*.cs" Condition="'$(ContractGeneratedDirectory)' != ''" />
    <Compile Remove="Tests/**/*.cs" />
    <EmbeddedResource Include="Contracts/contracts.schema.json"><LogicalName>VoiceInput.Contracts.schema.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Contracts/endpoints.json"><LogicalName>VoiceInput.Contracts.endpoints.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="UI/VoicePanel.bsml"><LogicalName>VoiceInput.UI.VoicePanel.bsml</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="UI/VoiceSettings.bsml"><LogicalName>VoiceInput.UI.VoiceSettings.bsml</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="manifest.json"><LogicalName>VoiceInput.manifest.json</LogicalName></EmbeddedResource>
    <InternalsVisibleTo Include="VoiceInput.RuntimeSmoke" />
  </ItemGroup>
</Project>
